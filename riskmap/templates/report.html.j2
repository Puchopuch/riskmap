<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>riskmap report - {{ generated }}</title>
<style>
  :root {
    --page: #f9f9f7; --surface: #fcfcfb; --ink: #0b0b0b; --ink-2: #52514e; --muted: #898781;
    --grid: #e1e0d9; --border: rgba(11, 11, 11, 0.10);
    --critical: #d03b3b; --high: #ec835a; --medium: #fab219; --low: #898781;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --page: #0d0d0d; --surface: #1a1a19; --ink: #f0efec; --ink-2: #c3c2b7;
      --grid: #2c2c2a; --border: rgba(255, 255, 255, 0.10);
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--page); color: var(--ink);
         font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  main { max-width: 1120px; margin: 0 auto; padding: 40px 24px 56px; }
  h1 { font-size: 28px; margin: 0 0 4px; }
  h2 { font-size: 20px; margin: 40px 0 12px; }
  h3 { font-size: 16px; margin: 24px 0 8px; }
  .meta { color: var(--ink-2); margin: 0; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin-top: 28px; }
  .tile { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 16px 18px; }
  .tile .label { display: flex; align-items: center; gap: 8px; color: var(--ink-2); font-size: 14px; }
  .tile .value { font-size: 34px; font-weight: 600; line-height: 1.2; margin-top: 4px; }
  .dot { display: inline-block; flex: none; width: 10px; height: 10px; border-radius: 50%; }
  .dot.critical { background: var(--critical); }
  .dot.high { background: var(--high); }
  .dot.medium { background: var(--medium); }
  .dot.low { background: var(--low); }
  table { width: 100%; border-collapse: collapse; background: var(--surface);
          border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
  th, td { text-align: left; vertical-align: baseline; padding: 12px 14px; border-bottom: 1px solid var(--grid); }
  tbody tr:last-child td { border-bottom: none; }
  th { font-size: 12px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); }
  .sev { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; white-space: nowrap; }
  .desc { color: var(--ink-2); margin-top: 4px; }
  .fix { margin-top: 6px; }
  .fix span { font-weight: 600; }
  code, .evidence { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 13px; }
  .evidence { color: var(--ink-2); word-break: break-word; }
  .location { white-space: nowrap; }
  footer { margin-top: 48px; color: var(--muted); font-size: 13px; }
  @media print { body { background: #fff; } .tile, table { break-inside: avoid; } }
</style>
</head>
<body>
<main>
  <header>
    <h1>Network risk report</h1>
    <p class="meta">Generated by riskmap {{ version }} on {{ generated }} &middot; {{ hosts|length }} host(s) &middot; {{ open_ports }} open ports &middot; {{ findings|length }} findings</p>
  </header>

  <section class="tiles" aria-label="Findings by severity">
    {% for level in severities %}
    <div class="tile">
      <div class="label"><span class="dot {{ level }}"></span>{{ level|capitalize }}</div>
      <div class="value">{{ counts[level] }}</div>
    </div>
    {% endfor %}
  </section>

  <h2>Findings</h2>
  {% if findings %}
  <table>
    <thead>
      <tr><th>Severity</th><th>Location</th><th>Finding</th><th>Evidence</th></tr>
    </thead>
    <tbody>
      {% for finding in findings %}
      <tr>
        <td><span class="sev"><span class="dot {{ finding.rule.severity }}"></span>{{ finding.rule.severity|capitalize }}</span></td>
        <td class="location"><code>{{ finding.location }}</code></td>
        <td>
          <strong>{{ finding.rule.title }}</strong>
          <div class="desc">{{ finding.rule.description }}</div>
          <div class="fix"><span>Fix:</span> {{ finding.rule.recommendation }}</div>
        </td>
        <td class="evidence">{{ finding.evidence }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p>No finding.</p>
  {% endif %}

  <h2>Inventory</h2>
  {% for host in hosts %}
  <h3>{{ host.ip }}{% if host.hostname %} ({{ host.hostname }}){% endif %}</h3>
  <table>
    <thead>
      <tr><th>Port</th><th>Service</th><th>Version</th></tr>
    </thead>
    <tbody>
      {% for service in host.services %}
      <tr>
        <td><code>{{ service.port }}/{{ service.protocol }}</code></td>
        <td>{{ service.name }}</td>
        <td>{{ service.banner }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endfor %}

  <footer>
    Only scan networks you are authorized to test. Findings come from service banners and Nmap scripts: verify them manually before acting.
  </footer>
</main>
</body>
</html>
